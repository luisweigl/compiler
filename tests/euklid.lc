/*
  Berechnung von ggT und kgV zweier Zahlen:
  Zahlen: a = 48, b = 18
  ggT(48, 18) = 6
  kgV(48, 18) = (48 * 18) / 6 = 144
*/

int a = 48;
int b = 18;

// Originale Werte sichern fuer die kgV-Berechnung
int orig_a = a;
int orig_b = b;

// Euklidischer Algorithmus mit Modulo
while (b != 0) {
    int temp = b;
    b = a % b;
    a = temp;
}

int ggt = a;
print(ggt); /* Erwartet: 6 */

// kgV-Formel: (orig_a * orig_b) / ggt
int kgv = (orig_a * orig_b) / ggt;
print(kgv); /* Erwartet: 144 */

// Zusatztest: Pruefen, ob kgV durch 10 teilbar ist
if (kgv % 10 == 0) {
    print(1);
} else {
    print(0); /* Erwartet: 0 (da 144 nicht auf 0 endet) */
}